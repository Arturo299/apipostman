{
	"info": {
		"name": "Pizzería API — Tests día 3",
		"description": "Ejemplos de tests del día 3 (ver docs/day-03/TESTS.md).\n\nCubre: el login que guarda el token, la captura de ids (body y cabecera Location), el ciclo de vida completo de un ingrediente, el impacto del coste de un ingrediente en el precio de una pizza, la seguridad básica y el contrato OpenAPI.\n\nRequiere el entorno «Pizzería - DEV» de docs/day-02/environments. Ejecútala completa con el Runner o con:\n\nnewman run docs/day-03/pizzeria-api-tests-dia3.postman_collection.json -e docs/day-02/environments/pizzeria-dev.postman_environment.json",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"auth": {
		"type": "bearer",
		"bearer": [
			{
				"key": "token",
				"value": "{{token}}",
				"type": "string"
			}
		]
	},
	"event": [
		{
			"listen": "prerequest",
			"script": {
				"type": "text/javascript",
				"exec": [
					"// [global] 1. Sin baseUrl no hay nada que probar",
					"if (!pm.variables.get(\"baseUrl\")) {",
					"    throw new Error(\"No hay baseUrl: selecciona el entorno «Pizzería - DEV»\");",
					"}",
					"",
					"// [global] 2. Nunca escribir en PROD desde la suite de pruebas",
					"const entorno = pm.environment.name || \"\";",
					"if (/PROD/i.test(entorno) && pm.request.method !== \"GET\") {",
					"    console.warn(`⛔ ${pm.info.requestName}: ${pm.request.method} omitido en ${entorno}`);",
					"    pm.execution.skipRequest();",
					"}",
					"",
					"// [global] 3. Login automático: cualquier request funciona aunque se ejecute suelta",
					"const esLogin = /\\/api\\/auth\\/(login|refresh)$/.test(pm.request.url.getPath());",
					"const token = pm.environment.get(\"token\");",
					"const caducaEn = Number(pm.environment.get(\"tokenExpiresAt\") || 0);",
					"",
					"if (!esLogin && (!token || Date.now() > caducaEn - 10000)) {",
					"    pm.sendRequest({",
					"        url: pm.variables.replaceIn(\"{{baseUrl}}/api/auth/login\"),",
					"        method: \"POST\",",
					"        header: { \"Content-Type\": \"application/json\" },",
					"        body: {",
					"            mode: \"raw\",",
					"            raw: JSON.stringify({ username: pm.variables.get(\"username\"), password: pm.variables.get(\"password\") })",
					"        }",
					"    }, (err, res) => {",
					"        if (err || res.code !== 200) {",
					"            console.error(\"Login automático fallido\", err || res.text());",
					"            return;",
					"        }",
					"        const body = res.json();",
					"        pm.environment.set(\"token\", body.accessToken);",
					"        pm.environment.set(\"refreshToken\", body.refreshToken);",
					"        pm.environment.set(\"tokenExpiresAt\", Date.now() + body.expiresIn * 1000);",
					"        console.log(\"🔑 Login automático\");",
					"    });",
					"}"
				]
			}
		},
		{
			"listen": "test",
			"script": {
				"type": "text/javascript",
				"exec": [
					"// [global] Comprobaciones mínimas que valen para CUALQUIER request",
					"pm.test(\"[global] El servidor no devuelve un 5xx\", () => {",
					"    pm.expect(pm.response.code, pm.response.text()).to.be.below(500);",
					"});",
					"",
					"if (pm.response.code !== 204) {",
					"    pm.test(\"[global] La respuesta es JSON\", () => {",
					"        pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\");",
					"    });",
					"}"
				]
			}
		}
	],
	"variable": [
		{
			"key": "ingredientName",
			"value": ""
		},
		{
			"key": "pizzaName",
			"value": ""
		},
		{
			"key": "precioInicial",
			"value": ""
		}
	],
	"item": [
		{
			"name": "1. Contrato",
			"description": "Smoke test del contrato OpenAPI. Ejecútalo antes de importar o regenerar la colección desde /v3/api-docs.",
			"item": [
				{
					"name": "Contrato OpenAPI",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"const contrato = pm.response.json();",
									"",
									"pm.test(\"200 y es un documento OpenAPI 3.x\", () => {",
									"    pm.response.to.have.status(200);",
									"    pm.expect(contrato.openapi).to.match(/^3\\./);",
									"});",
									"",
									"pm.test(\"Publica todas las rutas que usa la colección\", () => {",
									"    pm.expect(contrato.paths).to.include.all.keys(",
									"        \"/api/auth/login\", \"/api/auth/me\",",
									"        \"/api/ingredients\", \"/api/ingredients/{id}\",",
									"        \"/api/pizzas\", \"/api/pizzas/{id}\");",
									"});",
									"",
									"pm.test(\"Declara la seguridad Bearer\", () => {",
									"    pm.expect(contrato.components.securitySchemes.bearerAuth.scheme).to.equal(\"bearer\");",
									"});",
									"",
									"pm.test(\"Las operaciones de escritura exigen token\", () => {",
									"    const escrituras = [",
									"        contrato.paths[\"/api/ingredients\"].post,",
									"        contrato.paths[\"/api/ingredients/{id}\"].put,",
									"        contrato.paths[\"/api/ingredients/{id}\"].delete,",
									"        contrato.paths[\"/api/pizzas\"].post",
									"    ];",
									"    escrituras.forEach(op => {",
									"        const esquemas = (op.security || []).flatMap(Object.keys);",
									"        pm.expect(esquemas, op.summary).to.include(\"bearerAuth\");",
									"    });",
									"});",
									"",
									"pm.test(\"IngredientRequest exige name, cost y vegetarian\", () => {",
									"    const esquema = contrato.components.schemas.IngredientRequest;",
									"    pm.expect(esquema.required).to.have.members([\"name\", \"cost\", \"vegetarian\"]);",
									"});"
								]
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/v3/api-docs",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"v3",
								"api-docs"
							]
						},
						"auth": {
							"type": "noauth"
						}
					},
					"response": []
				}
			]
		},
		{
			"name": "2. Auth",
			"description": "El login produce el token que consumen todas las requests de escritura.",
			"item": [
				{
					"name": "Login",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"// 1º se comprueba, 2º se guarda: así un login fallido no deja un token basura en el entorno",
									"pm.test(\"Login correcto (200)\", () => {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"if (pm.response.code === 200) {",
									"    const body = pm.response.json();",
									"",
									"    pm.test(\"Devuelve accessToken, refreshToken, tokenType y expiresIn\", () => {",
									"        pm.expect(body).to.include.all.keys(\"accessToken\", \"refreshToken\", \"tokenType\", \"expiresIn\");",
									"        pm.expect(body.accessToken).to.be.a(\"string\").and.not.be.empty;",
									"        pm.expect(body.refreshToken).to.not.equal(body.accessToken);",
									"        pm.expect(body.tokenType).to.equal(\"Bearer\");",
									"        pm.expect(body.expiresIn).to.be.a(\"number\").and.above(0);",
									"    });",
									"",
									"    pm.environment.set(\"token\", body.accessToken);",
									"    pm.environment.set(\"refreshToken\", body.refreshToken);",
									"    pm.environment.set(\"tokenExpiresAt\", Date.now() + body.expiresIn * 1000);",
									"",
									"    // Test del propio script: ¿se ha escrito en el entorno lo que esperábamos?",
									"    pm.test(\"El token queda guardado en el entorno\", () => {",
									"        pm.expect(pm.environment.get(\"token\")).to.equal(body.accessToken);",
									"    });",
									"} else {",
									"    pm.environment.unset(\"token\");",
									"}",
									"",
									"pm.test(\"La respuesta no devuelve la contraseña\", () => {",
									"    pm.expect(pm.response.text()).to.not.include(pm.variables.get(\"password\"));",
									"});"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/api/auth/login",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"auth",
								"login"
							]
						},
						"body": {
							"mode": "raw",
							"raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"auth": {
							"type": "noauth"
						}
					},
					"response": []
				},
				{
					"name": "Me (el token funciona)",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"const me = pm.response.json();",
									"",
									"pm.test(\"El token guardado es válido (200)\", () => {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"El token pertenece al usuario del entorno\", () => {",
									"    pm.expect(me.username).to.equal(pm.environment.get(\"username\"));",
									"});",
									"",
									"pm.test(\"Al token le queda vida\", () => {",
									"    pm.expect(me.expiresIn).to.be.above(0);",
									"});"
								]
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/auth/me",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"auth",
								"me"
							]
						}
					},
					"response": []
				}
			]
		},
		{
			"name": "3. Ingredientes (requests independientes)",
			"description": "Cada request prepara sus propios datos en el pre-request (Arrange). Se pueden ejecutar en cualquier orden y por separado: un DELETE suelto crea antes el ingrediente que va a borrar.",
			"item": [
				{
					"name": "Crear ingrediente",
					"event": [
						{
							"listen": "prerequest",
							"script": {
								"type": "text/javascript",
								"exec": [
									"// Nombre único: la carpeta se puede repetir sin chocar con el 409",
									"pm.collectionVariables.set(\"ingredientName\", `Test ${Date.now()}`);"
								]
							}
						},
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"201 Created\", () => {",
									"    pm.response.to.have.status(201);",
									"});",
									"",
									"if (pm.response.code === 201) {",
									"    const creado = pm.response.json();",
									"    const enviado = JSON.parse(pm.variables.replaceIn(pm.request.body.raw));",
									"",
									"    pm.test(\"Devuelve lo que se envió, con un id nuevo\", () => {",
									"        pm.expect(creado.id).to.be.a(\"number\");",
									"        pm.expect(creado.name).to.equal(enviado.name);",
									"        pm.expect(creado.cost).to.equal(enviado.cost);",
									"        pm.expect(creado.vegetarian).to.equal(enviado.vegetarian);",
									"    });",
									"",
									"    pm.test(\"La cabecera Location apunta al recurso creado\", () => {",
									"        const location = pm.response.headers.get(\"Location\");",
									"        pm.expect(location).to.match(new RegExp(`/api/ingredients/${creado.id}$`));",
									"    });",
									"",
									"    pm.environment.set(\"ingredientId\", creado.id);",
									"}"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/api/ingredients",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"ingredients"
							]
						},
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"{{ingredientName}}\",\n  \"cost\": 0.75,\n  \"vegetarian\": true\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						}
					},
					"response": []
				},
				{
					"name": "Obtener ingrediente",
					"event": [
						{
							"listen": "prerequest",
							"script": {
								"type": "text/javascript",
								"exec": [
									"// Arrange: garantiza que {{ingredientId}} apunta a un ingrediente que existe",
									"if (/PROD/i.test(pm.environment.name || \"\")) {",
									"    console.warn(`⛔ ${pm.info.requestName}: sin datos de prueba en ${pm.environment.name}`);",
									"    pm.execution.skipRequest();",
									"    return;                                   // ni fixture ni request",
									"}",
									"const baseUrl = pm.variables.get(\"baseUrl\");",
									"const id = pm.environment.get(\"ingredientId\");",
									"",
									"function crearIngrediente() {",
									"    const nombre = `Test ${Date.now()}`;",
									"    pm.sendRequest({",
									"        url: `${baseUrl}/api/ingredients`,",
									"        method: \"POST\",",
									"        header: { \"Content-Type\": \"application/json\", \"Authorization\": `Bearer ${pm.environment.get(\"token\")}` },",
									"        body: { mode: \"raw\", raw: JSON.stringify({ name: nombre, cost: 0.75, vegetarian: true }) }",
									"    }, (err, res) => {",
									"        pm.test(\"[arrange] Ingrediente de prueba creado\", () => {",
									"            pm.expect(err).to.be.null;",
									"            pm.expect(res.code).to.equal(201);",
									"        });",
									"        pm.environment.set(\"ingredientId\", res.json().id);",
									"        pm.collectionVariables.set(\"ingredientName\", nombre);",
									"        console.log(`🧪 Arrange: creado el ingrediente ${res.json().id}`);",
									"    });",
									"}",
									"",
									"if (!id) {",
									"    crearIngrediente();",
									"} else {",
									"    pm.sendRequest(`${baseUrl}/api/ingredients/${id}`, (err, res) => {",
									"        if (res.code === 404) {",
									"            crearIngrediente();                         // el id guardado ya no existe",
									"        } else {",
									"            pm.collectionVariables.set(\"ingredientName\", res.json().name);",
									"        }",
									"    });",
									"}"
								]
							}
						},
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"const ingrediente = pm.response.json();",
									"",
									"pm.test(\"200 OK\", () => {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Devuelve el ingrediente pedido\", () => {",
									"    // Las variables se guardan como texto: convierte antes de comparar",
									"    pm.expect(ingrediente.id).to.equal(Number(pm.environment.get(\"ingredientId\")));",
									"    pm.expect(ingrediente.name).to.equal(pm.collectionVariables.get(\"ingredientName\"));",
									"});"
								]
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/ingredients/{{ingredientId}}",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"ingredients",
								"{{ingredientId}}"
							]
						}
					},
					"response": []
				},

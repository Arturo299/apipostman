{
	"info": {
		"_postman_id": "645c36c2-be9d-5252-99ea-6ad04d2eebb7",
		"name": "Pizzería API",
		"description": "Colección de referencia del día 3: CRUD de ingredientes y pizzas con Bearer heredado, login que guarda el token en el entorno y captura automática de ids.\n\nRequiere un entorno con `baseUrl`, `username` y `password` (ver `docs/day-02/environments`).",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"auth": {
		"type": "bearer",
		"bearer": [
			{
				"key": "token",
				"value": "{{token}}",
				"type": "string"
			}
		]
	},
	"item": [
		{
			"name": "Auth",
			"item": [
				{
					"name": "Login",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/api/auth/login",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"auth",
								"login"
							]
						},
						"body": {
							"mode": "raw",
							"raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"auth": {
							"type": "noauth"
						},
						"description": "Devuelve un `accessToken` y un `refreshToken`. El script los guarda en el entorno."
					},
					"response": [],
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"const body = pm.response.json();",
									"pm.environment.set(\"token\", body.accessToken);",
									"pm.environment.set(\"refreshToken\", body.refreshToken);",
									"pm.environment.set(\"tokenExpiresAt\", Date.now() + body.expiresIn * 1000);",
									"console.log(`Token guardado, caduca en ${body.expiresIn} s`);"
								]
							}
						}
					]
				},
				{
					"name": "Refresh",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/api/auth/refresh",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"auth",
								"refresh"
							]
						},
						"body": {
							"mode": "raw",
							"raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"auth": {
							"type": "noauth"
						}
					},
					"response": [],
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"const body = pm.response.json();",
									"pm.environment.set(\"token\", body.accessToken);",
									"pm.environment.set(\"refreshToken\", body.refreshToken);",
									"pm.environment.set(\"tokenExpiresAt\", Date.now() + body.expiresIn * 1000);",
									"console.log(`Token guardado, caduca en ${body.expiresIn} s`);"
								]
							}
						}
					]
				},
				{
					"name": "Me",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/auth/me",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"auth",
								"me"
							]
						}
					},
					"response": []
				}
			]
		},

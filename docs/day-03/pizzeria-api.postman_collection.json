							]
						},
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"{{ingredientName}}\",\n  \"cost\": 0.75,\n  \"vegetarian\": true\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						}
					},
					"response": [],
					"event": [
						{
							"listen": "prerequest",
							"script": {
								"type": "text/javascript",
								"exec": [
									"// Nombre único para no chocar con el 409 por nombre duplicado",
									"pm.collectionVariables.set(\"ingredientName\", \"Ingrediente \" + Date.now());"
								]
							}
						},
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"if (pm.response.code === 201) {",
									"    pm.environment.set(\"ingredientId\", pm.response.json().id);",
									"}"
								]
							}
						}
					]

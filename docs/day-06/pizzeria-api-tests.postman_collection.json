									"    const i = pm.response.json();",
									"    pm.expect(i.name).to.equal(\"Mozzarella\");",
									"    pm.expect(i.cost).to.be.closeTo(1.70, 0.001);",
									"    pm.expect(i.vegetarian).to.be.true;",
									"});"
								]
							}

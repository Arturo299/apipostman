{
	"info": {
		"_postman_id": "93d48dac-9889-56a9-b48c-4ba7be22d780",
		"name": "Pizzería API - Tests",
		"description": "Suite de regresión de la Pizzería API (solución de los días 4 a 6).\n\n* Autenticación automática con refresh token en el pre-request de la colección.\n* Tests globales en el post-response de la colección y regla del precio en la carpeta *Pizzas*.\n* Las carpetas *Data-driven* se ejecutan con un data file: `newman run ... --folder \"06 Data-driven ingredientes\" -d data/ingredientes.csv`.\n\nRequiere un entorno con `baseUrl`, `username` y `password`.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"auth": {
		"type": "bearer",
		"bearer": [
			{
				"key": "token",
				"value": "{{token}}",
				"type": "string"
			}
		]
	},
	"item": [
		{
			"name": "01 Auth",
			"item": [
				{
					"name": "Login",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/api/auth/login",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"auth",
								"login"
							]
						},
						"body": {
							"mode": "raw",
							"raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"auth": {
							"type": "noauth"
						}
					},
					"response": [],
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"Login correcto (200)\", () => pm.response.to.have.status(200));",
									"",
									"pm.test(\"Devuelve access y refresh token\", () => {",
									"    const tokens = pm.response.json();",
									"    pm.expect(tokens).to.include.all.keys(\"accessToken\", \"refreshToken\", \"tokenType\", \"expiresIn\");",
									"    pm.expect(tokens.tokenType).to.equal(\"Bearer\");",
									"    pm.expect(tokens.expiresIn).to.be.above(0);",
									"});",
									"",
									"const body = pm.response.json();",
									"pm.environment.set(\"token\", body.accessToken);",
									"pm.environment.set(\"refreshToken\", body.refreshToken);",
									"pm.environment.set(\"tokenExpiresAt\", Date.now() + body.expiresIn * 1000);",
									"console.log(`Token guardado, caduca en ${body.expiresIn} s`);"
								]
							}
						}
					]
				},
				{
					"name": "Usuario actual",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/auth/me",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"auth",
								"me"
							]
						}
					},
					"response": [],
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"200 con el usuario del token\", () => {",
									"    pm.response.to.have.status(200);",
									"    pm.expect(pm.response.json().username).to.equal(pm.variables.get(\"username\"));",
									"});"
								]
							}
						}
					]
				},
				{
					"name": "Refrescar token",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/api/auth/refresh",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"auth",
								"refresh"
							]
						},
						"body": {
							"mode": "raw",
							"raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"auth": {
							"type": "noauth"
						}
					},
					"response": [],
					"event": [
						{
							"listen": "prerequest",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.collectionVariables.set(\"tokenAnterior\", pm.environment.get(\"token\"));"
								]
							}
						},
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"Refresh correcto (200)\", () => pm.response.to.have.status(200));",
									"pm.test(\"Emite un access token nuevo\", () => {",
									"    pm.expect(pm.response.json().accessToken).to.not.equal(pm.collectionVariables.get(\"tokenAnterior\"));",
									"});",
									"",
									"const body = pm.response.json();",
									"pm.environment.set(\"token\", body.accessToken);",
									"pm.environment.set(\"refreshToken\", body.refreshToken);",
									"pm.environment.set(\"tokenExpiresAt\", Date.now() + body.expiresIn * 1000);",
									"console.log(`Token guardado, caduca en ${body.expiresIn} s`);"
								]
							}
						}
					]
				}
			]
		},
		{
			"name": "02 Ingredientes",
			"item": [
				{
					"name": "Listar ingredientes",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/ingredients",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"ingredients"
							]
						}
					},
					"response": [],
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"const ingredientes = pm.response.json();",
									"const schema = JSON.parse(pm.collectionVariables.get(\"ingredientSchema\"));",
									"",
									"pm.test(\"200 y un array no vacío\", () => {",
									"    pm.response.to.have.status(200);",
									"    pm.expect(ingredientes).to.be.an(\"array\").that.is.not.empty;",
									"});",
									"pm.test(\"Cada elemento cumple el esquema\", () => {",
									"    pm.response.to.have.jsonSchema({ type: \"array\", items: schema });",
									"});",
									"pm.test(\"Ordenados por nombre\", () => {",
									"    const nombres = ingredientes.map(i => i.name);",
									"    pm.expect(nombres).to.eql([...nombres].sort((a, b) => a.localeCompare(b)));",
									"});"
								]
							}
						}
					]
				},

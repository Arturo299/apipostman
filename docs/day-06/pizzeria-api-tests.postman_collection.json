						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"200 y cumple el esquema\", () => {",
									"    pm.response.to.have.status(200);",
									"    pm.response.to.have.jsonSchema(JSON.parse(pm.collectionVariables.get(\"ingredientSchema\")));",

									"const pizza = pm.response.json();",
									"pm.test(\"200 y cumple el esquema\", () => {",
									"    pm.response.to.have.status(200);",
									"    pm.response.to.have.jsonSchema(JSON.parse(pm.collectionVariables.get(\"pizzaSchema\")));",
									"});",
									"pm.test(\"Margarita: 4 ingredientes, 4,30 € de coste y 5,16 € de precio\", () => {",
									"    pm.expect(pizza.name).to.equal(\"Margarita\");",
									"    pm.expect(pizza.ingredients).to.have.lengthOf(4);",
									"    pm.expect(pizza.ingredientsCost).to.be.closeTo(4.30, 0.001);",
									"    pm.expect(pizza.profitMargin).to.equal(0.2);",
									"    pm.expect(pizza.price).to.be.closeTo(5.16, 0.001);",
									"});"
								]
							}
						}
					]
				}
			],
			"event": [
				{
					"listen": "test",
					"script": {
						"type": "text/javascript",
						"exec": [
							"// Regla de negocio para cualquier pizza devuelta por la carpeta: price = ingredientsCost × 1,20",
							"if (pm.response.code === 200 || pm.response.code === 201) {",
							"    const data = pm.response.json();",
							"    const pizzas = Array.isArray(data) ? data : [data];",
							"    pm.test(\"[pizzas] price = suma de ingredientes × 1,20\", () => {",
							"        pizzas.forEach(p => {",
							"            const suma = p.ingredients.reduce((t, i) => t + i.cost, 0);",
							"            pm.expect(p.ingredientsCost, p.name).to.be.closeTo(suma, 0.001);",
							"            pm.expect(p.price, p.name).to.be.closeTo(Math.round(suma * 1.2 * 100) / 100, 0.001);",
							"        });",
							"    });",
							"}"
						]
					}
				}
			]
		},

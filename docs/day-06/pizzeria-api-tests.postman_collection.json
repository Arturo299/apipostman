	"event": [
		{
			"listen": "prerequest",
			"script": {
				"type": "text/javascript",
				"exec": [
					"// Autenticación automática a nivel de colección (días 5 y 6):",
					"//  1. Si hay un token vigente, no hace nada.",
					"//  2. Si ha caducado y hay refresh token, lo renueva con /api/auth/refresh.",
					"//  3. Si no hay refresh token o el refresco falla, hace login con username/password.",
					"const url = pm.request.url.toString();",
					"if (url.includes(\"/api/auth/login\") || url.includes(\"/api/auth/refresh\")) {",
					"    return;",
					"}",
					"",
					"const MARGEN_MS = 5000;",
					"const token = pm.environment.get(\"token\");",
					"const expiresAt = Number(pm.environment.get(\"tokenExpiresAt\") || 0);",
					"if (token && Date.now() < expiresAt - MARGEN_MS) {",
					"    return;",
					"}",
					"",
					"const baseUrl = pm.variables.get(\"baseUrl\");",
					"const guardar = (res) => {",
					"    const body = res.json();",
					"    pm.environment.set(\"token\", body.accessToken);",
					"    pm.environment.set(\"refreshToken\", body.refreshToken);",
					"    pm.environment.set(\"tokenExpiresAt\", Date.now() + body.expiresIn * 1000);",
					"};",
					"const peticion = (path, payload) => ({",
					"    url: baseUrl + path,",
					"    method: \"POST\",",
					"    header: { \"Content-Type\": \"application/json\" },",
					"    body: { mode: \"raw\", raw: JSON.stringify(payload) }",
					"});",
					"const login = () => pm.sendRequest(",
					"    peticion(\"/api/auth/login\", { username: pm.variables.get(\"username\"), password: pm.variables.get(\"password\") }),",
					"    (err, res) => {",
					"        if (err || res.code !== 200) {",
					"            console.error(\"Login automático fallido\", err || res.text());",
					"            return;",
					"        }",
					"        guardar(res);",
					"        console.log(\"🔑 Login automático\");",
					"    });",
					"",
					"const refreshToken = pm.environment.get(\"refreshToken\");",
					"if (!refreshToken) {",
					"    login();",
					"} else {",
					"    pm.sendRequest(peticion(\"/api/auth/refresh\", { refreshToken }), (err, res) => {",
					"        if (!err && res.code === 200) {",
					"            guardar(res);",
					"            console.log(\"♻️ Token renovado con refresh token\");",
					"        } else {",
					"            login();",
					"        }",
					"    });",
					"}"
				]
			}
		},
		{
			"listen": "test",
			"script": {
				"type": "text/javascript",
				"exec": [
					"// Tests comunes a todas las requests",
					"const maxMs = Number(pm.variables.get(\"maxResponseTime\") || 1000);",
					"pm.test(`[global] Responde en menos de ${maxMs} ms`, () => {",
					"    pm.expect(pm.response.responseTime).to.be.below(maxMs);",
					"});",
					"",
					"if (pm.response.code !== 204) {",
					"    pm.test(\"[global] Content-Type JSON\", () => {",
					"        pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\");",
					"    });",
					"}",
					"",
					"if (pm.response.code >= 400 && pm.response.code < 500) {",
					"    pm.test(\"[global] El error sigue el formato estándar\", () => {",
